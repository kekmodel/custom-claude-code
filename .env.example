# Anthropic API (Claude models)
# For v1, v2, v4
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API (for v3 only)
# v3 uses OpenAI Agents SDK which requires actual OpenAI API
OPENAI_API_KEY_V3=your-openai-api-key-here

# Alternative: Use OPENAI_API_KEY for v1/v2 with Anthropic API
OPENAI_API_KEY=your-anthropic-api-key-here
OPENAI_BASE_URL=https://api.anthropic.com/v1/
